{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product OS Constitution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "baseline", "apply_policy", "proposal_policy", "invariants"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "PROTECTED"},
    "baseline": {"type": "string", "minLength": 1},
    "apply_policy": {"const": "HUMAN_ONLY"},
    "proposal_policy": {"enum": ["AI_ALLOWED", "HUMAN_ONLY"]},
    "invariants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "statement"],
        "properties": {
          "id": {"type": "string", "pattern": "^CONST-[0-9]{3}$"},
          "name": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
