{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cursor-product-os.local/schemas/gate.schema.json",
  "title": "Product Gates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "gates"],
  "properties": {
    "schema_version": { "const": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_approval_required_for", "confidence_is_probability"],
      "properties": {
        "human_approval_required_for": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "confidence_is_probability": { "const": false }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "stage", "purpose", "human_approval", "required_artifacts", "checks"],
        "properties": {
          "id": { "type": "string", "pattern": "^G[0-9]+_[A-Z0-9_]+$" },
          "stage": { "type": "string" },
          "purpose": { "type": "string", "minLength": 1 },
          "human_approval": { "type": "boolean" },
          "approval_action": { "type": "string" },
          "required_artifacts": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
          "checks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          {
            "if": { "properties": { "human_approval": { "const": true } }, "required": ["human_approval"] },
            "then": { "required": ["approval_action"] }
          }
        ]
      }
    }
  }
}
